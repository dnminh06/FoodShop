<Window x:Class="FoodOrderWPF.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng ký tài khoản mới"
        Height="510" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9">
    <Grid Margin="24">
        <Border Background="White" CornerRadius="8" Padding="24" BorderBrush="#CBD5E1" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ĐĂNG KÝ TÀI KHOẢN"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Họ và tên (*):" FontWeight="SemiBold"/>
                <TextBox x:Name="txtFullName" Height="30"/>

                <TextBlock Text="Email đăng nhập (*):" FontWeight="SemiBold"/>
                <TextBox x:Name="txtEmail" Height="30"/>

                <TextBlock Text="Số điện thoại:" FontWeight="SemiBold"/>
                <TextBox x:Name="txtPhone" Height="30"/>

                <TextBlock Text="Mật khẩu (*):" FontWeight="SemiBold"/>
                <PasswordBox x:Name="txtPassword" Height="30"/>

                <TextBlock Text="Nhập lại mật khẩu (*):" FontWeight="SemiBold"/>
                <PasswordBox x:Name="txtConfirmPassword" Height="30"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Hủy"
                            Width="90"
                            Background="#E2E8F0"
                            Click="btnCancel_Click"/>
                    <Button Content="Đăng ký"
                            Width="110"
                            Background="#16A34A"
                            Foreground="White"
                            Click="btnSignup_Click"
                            IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
