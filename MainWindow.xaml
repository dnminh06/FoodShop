<Window x:Class="FoodOrderWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoodOrderWPF - Hệ thống Đặt đồ ăn Đa nhà hàng"
        Height="700" Width="1220"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E293B" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FOOD ORDER SYSTEM"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtCurrentUserInfo"
                               Text="Xin chào: Khách"
                               Foreground="#E2E8F0"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Button x:Name="btnHeaderCart"
                            Content="Giỏ hàng (0)"
                            Background="#F59E0B"
                            Foreground="#1E293B"
                            Click="btnHeaderCart_Click"/>
                    <Button x:Name="btnLogout"
                            Content="Đăng xuất"
                            Background="#EF4444"
                            Foreground="White"
                            Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="mainTabControl"
                    Grid.Row="1"
                    Margin="12"
                    FontSize="13"
                    SelectionChanged="mainTabControl_SelectionChanged">

            <TabItem x:Name="tabMenu" Header="  1. Thực đơn (Menu)  ">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.4*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Danh mục:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <ComboBox x:Name="cboMenuCategory"
                                          Width="150"
                                          Margin="0,0,12,0"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="CategoryId"
                                          SelectionChanged="cboMenuFilter_SelectionChanged"/>

                                <TextBlock Text="Nhà hàng:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <ComboBox x:Name="cboMenuRestaurant"
                                          Width="170"
                                          Margin="0,0,12,0"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="RestaurantId"
                                          SelectionChanged="cboMenuFilter_SelectionChanged"/>

                                <TextBlock Text="Tên món:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <TextBox x:Name="txtSearchProduct" Width="150" Margin="0,0,8,0"/>
                                <Button Content="Tìm kiếm" Background="#2563EB" Foreground="White" Click="btnSearchProduct_Click"/>
                                <Button Content="Hiện tất cả" Background="#E2E8F0" Click="btnResetMenu_Click"/>
                            </WrapPanel>
                        </Border>

                        <DataGrid x:Name="dgMenuProducts"
                                  Grid.Row="1"
                                  SelectionChanged="dgMenuProducts_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding ProductId}" Width="50"/>
                                <DataGridTextColumn Header="Tên món ăn" Binding="{Binding Name}" Width="1.3*"/>
                                <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="120"/>
                                <DataGridTextColumn Header="Nhà hàng" Binding="{Binding RestaurantName}" Width="1.2*"/>
                                <DataGridTextColumn Header="Giá (VNĐ)" Binding="{Binding Price, StringFormat=\{0:N0\}}" Width="95"/>
                                <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="1.4*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="CHI TIẾT MÓN ĂN" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                <TextBlock Text="Tên món:" Foreground="#64748B"/>
                                <TextBlock x:Name="lblDetailName" Text="(Chưa chọn món)" FontSize="16" FontWeight="Bold" Margin="0,2,0,10" TextWrapping="Wrap"/>

                                <TextBlock Text="Danh mục:" Foreground="#64748B"/>
                                <TextBlock x:Name="lblDetailCategory" Text="-" FontWeight="SemiBold" Margin="0,2,0,10"/>

                                <TextBlock Text="Nhà hàng cung cấp:" Foreground="#64748B"/>
                                <TextBlock x:Name="lblDetailRestaurant" Text="-" FontWeight="SemiBold" Margin="0,2,0,10" TextWrapping="Wrap"/>

                                <TextBlock Text="Đơn giá:" Foreground="#64748B"/>
                                <TextBlock x:Name="lblDetailPrice" Text="0 đ" FontSize="15" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,10"/>

                                <TextBlock Text="Mô tả chi tiết:" Foreground="#64748B"/>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,16" MinHeight="70">
                                    <TextBlock x:Name="lblDetailDescription" Text="-" TextWrapping="Wrap"/>
                                </Border>

                                <Separator Margin="0,0,0,12"/>

                                <TextBlock Text="Số lượng muốn đặt:" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtBuyQuantity" Text="1" Width="100" HorizontalAlignment="Left"/>

                                <Button x:Name="btnAddToCart"
                                        Content="+ Thêm vào Giỏ hàng"
                                        Height="38"
                                        Margin="0,8,0,0"
                                        Background="#16A34A"
                                        Foreground="White"
                                        Click="btnAddToCart_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabCart" Header="  2. Giỏ hàng (Cart)  ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgCart" Grid.Row="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã món" Binding="{Binding ProductId}" Width="75"/>
                            <DataGridTextColumn Header="Tên món ăn" Binding="{Binding ProductName}" Width="1.6*"/>
                            <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="130"/>
                            <DataGridTextColumn Header="Nhà hàng" Binding="{Binding RestaurantName}" Width="1.4*"/>
                            <DataGridTextColumn Header="Đơn giá (VNĐ)" Binding="{Binding Price, StringFormat=\{0:N0\}}" Width="115"/>
                            <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="90"/>
                            <DataGridTextColumn Header="Thành tiền (VNĐ)" Binding="{Binding SubTotal, StringFormat=\{0:N0\}}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Địa chỉ giao hàng (*):" FontWeight="SemiBold"/>
                                    <TextBox x:Name="txtShippingAddress" Text="Số 10, Đường Tôn Thất Thuyết, Cầu Giấy, Hà Nội"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="Mã giảm giá (Voucher):" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="cboVoucher"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="VoucherId"
                                              SelectionChanged="cboVoucher_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Phương thức thanh toán:" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="cboPaymentMethod" SelectedValuePath="Tag" SelectedIndex="0">
                                        <ComboBoxItem Tag="COD" Content="COD (Tiền mặt)"/>
                                        <ComboBoxItem Tag="Momo" Content="Ví MoMo"/>
                                        <ComboBoxItem Tag="VNPay" Content="VNPay"/>
                                        <ComboBoxItem Tag="CreditCard" Content="Thẻ tín dụng"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="+ Tăng 1" Background="#E2E8F0" Click="btnCartIncrease_Click"/>
                                    <Button Content="- Giảm 1" Background="#E2E8F0" Click="btnCartDecrease_Click"/>
                                    <Button Content="Xóa món đang chọn" Background="#FEE2E2" Foreground="#991B1B" Click="btnCartRemoveItem_Click"/>
                                    <Button Content="Xóa trống giỏ" Background="#E2E8F0" Click="btnCartClear_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="TỔNG THANH TOÁN: " FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblCartTotal" Text="0 đ" FontSize="18" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center" Margin="4,0,16,0"/>
                                    <Button x:Name="btnCheckout"
                                            Content="Đặt hàng &amp; Thanh toán"
                                            Height="38"
                                            Background="#2563EB"
                                            Foreground="White"
                                            Click="btnCheckout_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabMyOrders" Header="  3. Đơn hàng của tôi  ">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Danh sách Đơn hàng đã đặt" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Làm mới" Background="#E2E8F0" Click="btnRefreshMyOrders_Click"/>
                                <Button Content="Xóa đơn đang chọn" Background="#FEE2E2" Foreground="#991B1B" Click="btnDeleteMyOrder_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid x:Name="dgMyOrders"
                                  Grid.Row="1"
                                  SelectionChanged="dgMyOrders_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderId}" Width="60"/>
                                <DataGridTextColumn Header="Ngày đặt" Binding="{Binding OrderDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="125"/>
                                <DataGridTextColumn Header="Địa chỉ giao" Binding="{Binding ShippingAddress}" Width="*"/>
                                <DataGridTextColumn Header="Voucher" Binding="{Binding VoucherCode}" Width="85"/>
                                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat=\{0:N0\}}" Width="95"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock x:Name="lblMyOrderDetailTitle"
                                       Text="Chi tiết đơn hàng (Chọn 1 đơn bên trái)"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid x:Name="dgMyOrderDetails" Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã món" Binding="{Binding ProductId}" Width="65"/>
                                <DataGridTextColumn Header="Tên món ăn" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="75"/>
                                <DataGridTextColumn Header="Đơn giá" Binding="{Binding PriceAtOrder, StringFormat=\{0:N0\}}" Width="95"/>
                                <DataGridTextColumn Header="Thành tiền" Binding="{Binding SubTotal, StringFormat=\{0:N0\}}" Width="105"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabManageProduct" Header="  4. Quản lý Món ăn  ">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="dgManageProducts"
                              Grid.Column="0"
                              Margin="0,0,12,0"
                              SelectionChanged="dgManageProducts_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="50"/>
                            <DataGridTextColumn Header="Tên món ăn" Binding="{Binding Name}" Width="1.3*"/>
                            <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="115"/>
                            <DataGridTextColumn Header="Nhà hàng" Binding="{Binding RestaurantName}" Width="1.2*"/>
                            <DataGridTextColumn Header="Giá (VNĐ)" Binding="{Binding Price, StringFormat=\{0:N0\}}" Width="90"/>
                            <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="1.4*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="THÔNG TIN MÓN ĂN" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

                                <TextBlock Text="ID Món ăn (Tự động):"/>
                                <TextBox x:Name="txtProductId" IsReadOnly="True" Background="#E2E8F0"/>

                                <TextBlock Text="Tên món ăn (*):"/>
                                <TextBox x:Name="txtProductName"/>

                                <TextBlock Text="Danh mục (*):"/>
                                <ComboBox x:Name="cboProductCategory"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="CategoryId"/>

                                <TextBlock Text="Nhà hàng (*):"/>
                                <ComboBox x:Name="cboProductRestaurant"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="RestaurantId"/>

                                <TextBlock Text="Giá bán (VNĐ) (*):"/>
                                <TextBox x:Name="txtProductPrice"/>

                                <TextBlock Text="Mô tả:"/>
                                <TextBox x:Name="txtProductDescription" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Thêm mới" Background="#16A34A" Foreground="White" Click="btnAddProduct_Click"/>
                                    <Button Content="Cập nhật (Sửa)" Background="#2563EB" Foreground="White" Click="btnUpdateProduct_Click"/>
                                    <Button Content="Xóa món" Background="#EF4444" Foreground="White" Click="btnDeleteProduct_Click"/>
                                    <Button Content="Làm mới" Background="#E2E8F0" Click="btnClearProductForm_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabManageOrder" Header="  5. Quản lý Đơn hàng  ">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="dgManageOrders"
                              Grid.Column="0"
                              Margin="0,0,12,0"
                              SelectionChanged="dgManageOrders_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderId}" Width="60"/>
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="1.2*"/>
                            <DataGridTextColumn Header="Ngày đặt" Binding="{Binding OrderDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="120"/>
                            <DataGridTextColumn Header="Địa chỉ giao" Binding="{Binding ShippingAddress}" Width="1.2*"/>
                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat=\{0:N0\}}" Width="95"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="CẬP NHẬT TRẠNG THÁI ĐƠN HÀNG" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Mã đơn hàng:"/>
                                        <TextBox x:Name="txtManageOrderId" IsReadOnly="True" Background="#E2E8F0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Tổng tiền (VNĐ):"/>
                                        <TextBox x:Name="txtManageOrderTotal" IsReadOnly="True" Background="#E2E8F0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Trạng thái đơn hàng:"/>
                                <ComboBox x:Name="cboOrderStatus" SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="Pending" Content="Pending (Chờ xác nhận)"/>
                                    <ComboBoxItem Tag="Processing" Content="Processing (Đang chuẩn bị)"/>
                                    <ComboBoxItem Tag="Delivering" Content="Delivering (Đang giao hàng)"/>
                                    <ComboBoxItem Tag="Completed" Content="Completed (Hoàn thành)"/>
                                    <ComboBoxItem Tag="Cancelled" Content="Cancelled (Đã hủy)"/>
                                </ComboBox>

                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="Lưu trạng thái" Background="#2563EB" Foreground="White" Click="btnUpdateOrderStatus_Click"/>
                                    <Button Content="Xóa đơn hàng" Background="#EF4444" Foreground="White" Click="btnDeleteManageOrder_Click"/>
                                    <Button Content="Làm mới danh sách" Background="#E2E8F0" Click="btnRefreshManageOrders_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="dgManageOrderDetails" Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã món" Binding="{Binding ProductId}" Width="65"/>
                                <DataGridTextColumn Header="Tên món ăn" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="75"/>
                                <DataGridTextColumn Header="Đơn giá" Binding="{Binding PriceAtOrder, StringFormat=\{0:N0\}}" Width="95"/>
                                <DataGridTextColumn Header="Thành tiền" Binding="{Binding SubTotal, StringFormat=\{0:N0\}}" Width="105"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabManageVoucher" Header="  6. Quản lý Voucher  ">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="dgManageVouchers"
                              Grid.Column="0"
                              Margin="0,0,12,0"
                              SelectionChanged="dgManageVouchers_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding VoucherId}" Width="45"/>
                            <DataGridTextColumn Header="Mã Voucher" Binding="{Binding VoucherCode}" Width="1.2*"/>
                            <DataGridTextColumn Header="Giảm (%)" Binding="{Binding DiscountPercent, StringFormat=\{0:0.##\}}" Width="85"/>
                            <DataGridTextColumn Header="Giảm tối đa (VNĐ)" Binding="{Binding MaxDiscountAmount, StringFormat=\{0:N0\}}" Width="130"/>
                            <DataGridTextColumn Header="Từ ngày" Binding="{Binding StartDate, StringFormat=\{0:yyyy-MM-dd\}}" Width="105"/>
                            <DataGridTextColumn Header="Đến ngày" Binding="{Binding EndDate, StringFormat=\{0:yyyy-MM-dd\}}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="THÔNG TIN VOUCHER" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

                                <TextBlock Text="Voucher ID (Tự động):"/>
                                <TextBox x:Name="txtVoucherId" IsReadOnly="True" Background="#E2E8F0"/>

                                <TextBlock Text="Mã Voucher (*):"/>
                                <TextBox x:Name="txtVoucherCode"/>

                                <TextBlock Text="Phần trăm giảm (%) (*):"/>
                                <TextBox x:Name="txtVoucherDiscountPercent"/>

                                <TextBlock Text="Giảm tối đa (VNĐ - Để trống nếu không giới hạn):"/>
                                <TextBox x:Name="txtVoucherMaxDiscount"/>

                                <TextBlock Text="Ngày bắt đầu (*):"/>
                                <DatePicker x:Name="dpVoucherStartDate" Margin="0,4,0,8"/>

                                <TextBlock Text="Ngày kết thúc (*):"/>
                                <DatePicker x:Name="dpVoucherEndDate" Margin="0,4,0,10"/>

                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="Thêm mới" Background="#16A34A" Foreground="White" Click="btnAddVoucher_Click"/>
                                    <Button Content="Cập nhật (Sửa)" Background="#2563EB" Foreground="White" Click="btnUpdateVoucher_Click"/>
                                    <Button Content="Xóa Voucher" Background="#EF4444" Foreground="White" Click="btnDeleteVoucher_Click"/>
                                    <Button Content="Làm mới" Background="#E2E8F0" Click="btnClearVoucherForm_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabManageUser" Header="  7. Quản lý Người dùng (Admin)  ">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="dgManageUsers"
                              Grid.Column="0"
                              Margin="0,0,12,0"
                              SelectionChanged="dgManageUsers_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="45"/>
                            <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="1.2*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.3*"/>
                            <DataGridTextColumn Header="Mật khẩu" Binding="{Binding PasswordHash}" Width="105"/>
                            <DataGridTextColumn Header="Số điện thoại" Binding="{Binding PhoneNumber}" Width="105"/>
                            <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleName}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="THÔNG TIN NGƯỜI DÙNG" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>

                                <TextBlock Text="User ID (Tự động):"/>
                                <TextBox x:Name="txtUserId" IsReadOnly="True" Background="#E2E8F0"/>

                                <TextBlock Text="Họ và tên (*):"/>
                                <TextBox x:Name="txtUserFullName"/>

                                <TextBlock Text="Email (*):"/>
                                <TextBox x:Name="txtUserEmail"/>

                                <TextBlock Text="Số điện thoại:"/>
                                <TextBox x:Name="txtUserPhone"/>

                                <TextBlock Text="Mật khẩu (*):"/>
                                <TextBox x:Name="txtUserPassword"/>

                                <TextBlock Text="Vai trò (Role):"/>
                                <ComboBox x:Name="cboUserRole" SelectedValuePath="Tag" SelectedIndex="0">
                                    <ComboBoxItem Tag="1" Content="1 - Customer (Khách hàng)"/>
                                    <ComboBoxItem Tag="2" Content="2 - Restaurant Manager (Chủ quán)"/>
                                    <ComboBoxItem Tag="3" Content="3 - Shipper (Giao hàng)"/>
                                    <ComboBoxItem Tag="4" Content="4 - Admin (Quản trị viên)"/>
                                </ComboBox>

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Thêm mới" Background="#16A34A" Foreground="White" Click="btnAddUser_Click"/>
                                    <Button Content="Cập nhật (Sửa)" Background="#2563EB" Foreground="White" Click="btnUpdateUser_Click"/>
                                    <Button Content="Xóa" Background="#EF4444" Foreground="White" Click="btnDeleteUser_Click"/>
                                    <Button Content="Làm mới" Background="#E2E8F0" Click="btnClearUserForm_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabRevenue" Header="  8. Doanh thu (Admin)  ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Từ ngày:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <DatePicker x:Name="dpRevFromDate" Width="135" Margin="0,0,12,0" VerticalAlignment="Center"/>

                            <TextBlock Text="Đến ngày:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <DatePicker x:Name="dpRevToDate" Width="135" Margin="0,0,12,0" VerticalAlignment="Center"/>

                            <TextBlock Text="Trạng thái đơn:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <ComboBox x:Name="cboRevStatusFilter" Width="230" Margin="0,0,12,0" SelectedValuePath="Tag" SelectedIndex="0">
                                <ComboBoxItem Tag="AllValid" Content="Tất cả đơn hợp lệ (Trừ Cancelled)"/>
                                <ComboBoxItem Tag="CompletedOnly" Content="Chỉ đơn đã Hoàn thành (Completed)"/>
                            </ComboBox>

                            <Button Content="Lọc thống kê" Background="#2563EB" Foreground="White" Click="btnFilterRevenue_Click"/>
                            <Button Content="Tất cả thời gian" Background="#E2E8F0" Click="btnResetRevenue_Click"/>
                        </WrapPanel>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Tổng số đơn hàng" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="lblRevTotalOrders" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Đơn đã hoàn thành" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="lblRevCompletedOrders" Text="0" FontSize="22" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Tổng số món đã bán" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="lblRevTotalItems" Text="0" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Tổng doanh thu thực thu" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="lblRevTotalRevenue" Text="0 đ" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Doanh thu theo Nhà hàng" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                            <DataGrid x:Name="dgRevenueByRestaurant" Grid.Row="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding RestaurantId}" Width="45"/>
                                    <DataGridTextColumn Header="Tên nhà hàng" Binding="{Binding RestaurantName}" Width="*"/>
                                    <DataGridTextColumn Header="Số đơn" Binding="{Binding OrderCount}" Width="75"/>
                                    <DataGridTextColumn Header="SL món" Binding="{Binding TotalQuantitySold}" Width="75"/>
                                    <DataGridTextColumn Header="Doanh thu (VNĐ)" Binding="{Binding TotalRevenue, StringFormat=\{0:N0\}}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Doanh thu theo Ngày" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                            <DataGrid x:Name="dgRevenueByDate" Grid.Row="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ngày" Binding="{Binding Date, StringFormat=\{0:yyyy-MM-dd\}}" Width="115"/>
                                    <DataGridTextColumn Header="Số đơn" Binding="{Binding OrderCount}" Width="85"/>
                                    <DataGridTextColumn Header="Doanh thu (VNĐ)" Binding="{Binding TotalRevenue, StringFormat=\{0:N0\}}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabProfile" Header="  9. Hồ sơ cá nhân (Profile)  ">
                <Grid Margin="10">
                    <Border Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24"
                            Width="460"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="THÔNG TIN CÁ NHÂN"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="Họ và tên (*):"/>
                            <TextBox x:Name="txtProfileFullName"/>

                            <TextBlock Text="Email đăng nhập (*):"/>
                            <TextBox x:Name="txtProfileEmail"/>

                            <TextBlock Text="Số điện thoại:"/>
                            <TextBox x:Name="txtProfilePhone"/>

                            <TextBlock Text="Mật khẩu (*):"/>
                            <TextBox x:Name="txtProfilePassword"/>

                            <TextBlock x:Name="lblProfileRole"
                                       Text="Vai trò: Customer"
                                       FontWeight="SemiBold"
                                       Foreground="#2563EB"
                                       Margin="0,4,0,12"/>

                            <Button Content="Lưu thay đổi Hồ sơ"
                                    Height="36"
                                    Background="#2563EB"
                                    Foreground="White"
                                    Click="btnSaveProfile_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
