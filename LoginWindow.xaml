<Window x:Class="FoodOrderWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoodOrderWPF - Đăng nhập"
        Height="420" Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F5F9">
    <Grid Margin="24">
        <Border Background="White" CornerRadius="8" Padding="24" BorderBrush="#CBD5E1" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FOOD ORDER SYSTEM"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Đăng nhập bằng Email"
                           FontSize="13"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Email đăng nhập:" FontWeight="SemiBold"/>
                <TextBox x:Name="txtEmail" Height="32"/>

                <TextBlock Text="Mật khẩu (Password):" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <PasswordBox x:Name="txtPassword" Height="32"/>

                <Button x:Name="btnLogin"
                        Content="Đăng nhập"
                        Height="36"
                        Margin="0,12,0,6"
                        Background="#2563EB"
                        Foreground="White"
                        Click="btnLogin_Click"
                        IsDefault="True"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnOpenSignup"
                            Grid.Column="0"
                            Content="Đăng ký tài khoản"
                            Background="#E2E8F0"
                            Foreground="#1E293B"
                            Click="btnOpenSignup_Click"/>
                    <Button x:Name="btnGuest"
                            Grid.Column="1"
                            Content="Xem Menu (Khách)"
                            Background="#F1F5F9"
                            Foreground="#334155"
                            Click="btnGuest_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
